{
  "extends": "../../tsconfig.json",
  "include": [
    "src/index.ts",
    "src/globals.d.ts",
    "src/**/*.d.ts",
    "src/lib/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/lib/runner/vendored-curl.embed.generated.ts"
  ],
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "stripInternal": true
  }
}
