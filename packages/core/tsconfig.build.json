{
  "extends": "../../tsconfig.json",
  "include": ["src/index.ts", "src/globals.d.ts", "src/lib/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts"],
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "stripInternal": true
  }
}
