{
  "$schema": "https://kulala.app/http-client.env.schema.json",
  "$kulalaShared": {
    "$kulalaDefaultHeaders": {
      "X-Kulala-Shared-Default-Header": "kulala-family"
    },
    "$kulalaDefaultCurlOptions": ["--insecure", "--max-time 2"],
    "API_URL": "https://echo.getkulala.net"
  },
  "default": {
    "env_name": "default",
    "grpc": {
      "addr": "grpc.postman-echo.com",
      "port": 443
    },
    "websocket": {
      "addr": "wss://ws.ifelse.io"
    }
  },
  "dev": {
    "env_name": "dev"
  },
  "staging": {
    "env_name": "staging"
  },
  "prod": {
    "$kulalaDefaultHeaders": {
      "X-Kulala-Default-Header-in-Prod": "kulala-family"
    },
    "$kulalaDefaultCurlOptions": ["--no-insecure", "--max-time 5"],
    "env_name": "prod"
  }
}
