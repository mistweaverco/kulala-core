# Example: chain a login request from a pre-request script (Bruno-style).
# Requires network access to httpbin.org.
import ./run-request-chaining/login.http

### Protected resource
< {%
  const res = await $kulala.runRequest("Login");
  const body = res.body;
  const token =
    typeof body === "object" &&
    body !== null &&
    "json" in body &&
    typeof (body as { json?: { access_token?: unknown } }).json === "object" &&
    (body as { json: { access_token?: unknown } }).json?.access_token != null
      ? String((body as { json: { access_token: unknown } }).json.access_token)
      : typeof body === "object" &&
          body !== null &&
          "access_token" in body
        ? String((body as { access_token: unknown }).access_token)
        : "";
  client.global.set("authToken", token);
%}

GET https://httpbin.org/bearer HTTP/1.1
Authorization: Bearer {{authToken}}
