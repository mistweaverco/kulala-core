### JS_SCRIPT_REQ

< {%
  request.variables.set("NAME", "kulala")
  client.global.set("GLOBAL_FOO", "bar")
%}

POST https://httpbin.org/post?name={{NAME}}
Content-Type: application/json
X-Global-Foo: {{GLOBAL_FOO}}

{
  "username": "user123",
  "password": "pass123",
  "doc_env_test": "{{ DOC_ENV_TEST }}",
  "OS_USER": "{{ $env.USER }}"
}

> {%
  async function main() {
    return new Promise((resolve) => {
      setTimeout(() => {
        resolve("Hello from Async!");
      }, 10);
    });
  }
  client.log(await main());
  client.log("Status", response.status)
  client.log("Date", response.headers.valueOf("Date") || "")
%}
