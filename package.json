{
  "name": "@mistweaverco/kulala-core",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "tsc --noEmit && prettier --check . && eslint .",
    "test": "bun test",
    "postinstall": "bun run scripts/ensure-vendored-curl.ts",
    "prepack": "bun run scripts/generate-vendored-curl.ts",
    "vendor": "bun run scripts/ensure-vendored-curl.ts && bun run scripts/generate-vendored-curl.ts"
  },
  "pkg": {
    "assets": [
      "vendor/curl/**/*"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/bun": "1.3.9",
    "@types/node": "25.5.0",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "form-data-encoder": "4.1.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.44.1",
    "wasmoon-lua5.1": "1.18.10"
  },
  "peerDependencies": {
    "typescript": "5.9.2"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ]
}
